// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  guid String @id @default(uuid())
  email String @unique
  password String
  firstName String
  lastName String
  username String @unique
  lists List[]
  dateCreated DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model List {
  guid String @id @default(uuid()) 
  user User @relation(fields: [userGuid], references: [guid])
  userGuid String
  name String
  items ListItem[]
  icon String
  allowedMediaType MediaType[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt  
  
 @@unique([userGuid,name])
}

model ListItem {
   guid String @id @default(uuid())
   list List @relation(fields: [listGuid], references: [guid])
   listGuid String
   media Media @relation(fields: [mediaGuid], references: [guid])
   mediaGuid String   
   createdAt DateTime @default(now())
   updatedAt DateTime @default(now()) @updatedAt
   
   @@unique([listGuid, mediaGuid])
}

model Media {
  guid String @id @default(uuid())
  title String
  movieDetails MovieDetails?
  animeDetails AnimeDetails?
  tvDetails TvDetails? 
  bookDetails BookDetails?
  listItems ListItem[]
  mediaType MediaType
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model MovieDetails {
  guid String @id @default(uuid())
  mediaGuid  String    @unique
  posterPath String
  overview  String
  releaseDate DateTime
  rating    Float
  genre     String[]
  video     String

  media    Media  @relation(fields: [mediaGuid], references: [guid])
}

model BookDetails {
  guid String @id @default(uuid())
  mediaGuid String    @unique
  title        String
  author       String
  description  String
  publishedDate DateTime
  bookImageUrl String

  media    Media  @relation(fields: [mediaGuid], references: [guid])
}

model TvDetails {
  guid String @id @default(uuid())
  mediaGuid    String    @unique
  postPath String
  backDropPath String
  overview String
  firstAirDate DateTime
  rating      Float
  video       String
  genre       String[]

  media      Media  @relation(fields: [mediaGuid], references: [guid])
}

model AnimeDetails {
  guid          String    @id @default(uuid())
  mediaGuid     String    @unique
  description String 
  averageScore Float?
  episodes Int?
  startDate DateTime?
  genres String[]
  titleRomaji String
  titleEnglish String?
  titleNative String?
  coverImageUrl String
  coverImageColor String?

  media         Media  @relation(fields: [mediaGuid], references: [guid])
}


enum MediaType {
  MOVIE
  TV 
  BOOK 
  ANIME
}


