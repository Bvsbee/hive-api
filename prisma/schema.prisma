// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  guid String @id @default(uuid())
  email String @unique
  password String
  firstName String
  lastName String
  username String @unique
  lists List[]
  dateCreated DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model List {
  guid String @id @default(uuid()) 
  user User @relation(fields: [userGuid], references: [guid])
  userGuid String
  name String
  items ListItem[]
  icon String
  allowedMediaType MediaType[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt  
  
 @@unique([userGuid,name])
}

model ListItem {
   guid String @id @default(uuid())
   list List @relation(fields: [listGuid], references: [guid])
   listGuid String
   media Media @relation(fields: [mediaGuid], references: [guid])
   mediaGuid String 

   @@unique([listGuid, mediaGuid])
}

model Media {
  guid String @id @default(uuid())
  title String
  synopsis String
  posterUrl String
  movieDetails MovieDetails?
  animeDetails AnimeDetails?
  tvDetails TvDetails? 
  bookDetails BookDetails?
  listItems ListItem[]
  mediaType MediaType
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model MovieDetails {
  guid String @id @default(uuid())
  mediaGuid  String    @unique
  runtime  Int?
  director String?
  tmdbId   String?

  media    Media  @relation(fields: [mediaGuid], references: [guid])
}

model BookDetails {
  guid String @id @default(uuid())
  mediaGuid String    @unique
  author   String?
  isbn     String?
  pages    Int?

  media    Media  @relation(fields: [mediaGuid], references: [guid])
}

model TvDetails {
  guid String @id @default(uuid())
  mediaGuid    String    @unique
  episodes   Int?
  network    String?

  media      Media  @relation(fields: [mediaGuid], references: [guid])
}

model AnimeDetails {
  guid          String    @id @default(uuid())
  mediaGuid     String    @unique
  studio        String?
  episodeCount  Int?

  media         Media  @relation(fields: [mediaGuid], references: [guid])
}


enum MediaType {
  MOVIE
  TV 
  BOOK 
  ANIME
}


